<Window x:Class="SonarEQChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sonar Auto Switch"
        Height="560" Width="780"
        MinHeight="480" MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>

        <!-- ── Color Palette ─────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgMain"     Color="#1b1b2b"/>
        <SolidColorBrush x:Key="BgSidebar"  Color="#141420"/>
        <SolidColorBrush x:Key="BgCard"     Color="#232336"/>
        <SolidColorBrush x:Key="BgInput"    Color="#1a1a28"/>
        <SolidColorBrush x:Key="BgHover"    Color="#2c2c42"/>
        <SolidColorBrush x:Key="BgSelected" Color="#27273d"/>
        <SolidColorBrush x:Key="Accent"     Color="#e06030"/>
        <SolidColorBrush x:Key="AccentHov"  Color="#f07040"/>
        <SolidColorBrush x:Key="TxtPrimary" Color="#e8e8f0"/>
        <SolidColorBrush x:Key="TxtSecond"  Color="#7878a0"/>
        <SolidColorBrush x:Key="TxtAccent"  Color="#e06030"/>
        <SolidColorBrush x:Key="Border"     Color="#2e2e48"/>
        <SolidColorBrush x:Key="Green"      Color="#4ec97e"/>
        <SolidColorBrush x:Key="Red"        Color="#e05555"/>

        <!-- ── FlatButton ──────────────────────────────────────────── -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35354e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── AccentButton ───────────────────────────────────────── -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"  Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHov}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#c04820"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DangerButton ───────────────────────────────────────── -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"  Value="#3a1a1a"/>
            <Setter Property="Foreground"  Value="{StaticResource Red}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a2222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── IconButton (square sidebar icons) ─────────────────── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource TxtSecond}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"         Value="48"/>
            <Setter Property="Height"        Value="48"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontFamily"    Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize"      Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1e1e30"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TitleBarButton ─────────────────────────────────────── -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource TxtSecond}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"         Value="46"/>
            <Setter Property="Height"        Value="32"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontFamily"    Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25253a"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CloseButton ────────────────────────────────────────── -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c42b1c"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Modern ComboBox ────────────────────────────────────── -->
        <ControlTemplate x:Key="ComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="5">
                <Grid HorizontalAlignment="Right" Width="20" Margin="0,0,4,0">
                    <Path Fill="{StaticResource TxtSecond}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="8,6"/>
            <Setter Property="Height"                  Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Template="{StaticResource ComboBoxTextBox}"
                                     Margin="10,0,28,0"
                                     Foreground="{StaticResource TxtPrimary}"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="240">
                                    <Border Background="{StaticResource BgCard}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#000000"
                                                              Opacity="0.5" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Hidden">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop"                Value="false"/>
                                <Setter TargetName="PART_EditableTextBox"   Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"            Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource TxtPrimary}"/>
            <Setter Property="Padding"     Value="10,7"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="2,0,2,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="bd" Property="Background" Value="#2a2a40"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ────────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"          Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"          Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Padding"             Value="8,0"/>
            <Setter Property="Height"              Value="32"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"          Value="{StaticResource TxtPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4a4a68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CheckBox ───────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bd" Width="20" Height="20"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="check"
                                      Data="M 3 10 L 8 15 L 17 5"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6a6a88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ScrollBar ──────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- ── AppRule ListBoxItem style (used in the rules ItemsControl) ── -->
        <Style x:Key="RuleItemStyle" TargetType="Border">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Background="Transparent">
                                <Border x:Name="Bg" Background="{StaticResource Border}" CornerRadius="10"/>
                                <Ellipse x:Name="Dot" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="DotTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                                <!-- X translation 20 moves dot from left to right -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  ROOT: Drop shadow wrapper                                    -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <Grid Margin="10">
        <Border CornerRadius="10" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.6"
                                  ShadowDepth="4" Direction="315"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <ColumnDefinition Width="48"/>
                    <!-- Main content -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════ -->
                <!--  LEFT: Icon Sidebar                           -->
                <!-- ══════════════════════════════════════════════ -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                        CornerRadius="10,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>   <!-- title bar space -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top nav icons -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                            <!-- Hamburger -->
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE700;" ToolTip="Menu"
                                    Click="BtnMenuToggle_Click"/>
                            <!-- Home / Dashboard -->
                            <Grid Width="48" Height="48">
                                <Button x:Name="btnNavHome" Style="{StaticResource IconButton}" Content="&#xE80F;" Foreground="{StaticResource Accent}" ToolTip="Auto Switch Profiles" Click="BtnNavHome_Click"/>
                                <Rectangle x:Name="rectHomeActive" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2" Visibility="Visible" IsHitTestVisible="False"/>
                            </Grid>
                            <!-- Devices -->
                            <Grid Width="48" Height="48">
                                <Button x:Name="btnNavDevices" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Device Manager" Click="BtnNavDevices_Click"/>
                                <Rectangle x:Name="rectDevicesActive" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <!-- Help -->
                            <Grid Width="48" Height="48">
                                <Button x:Name="btnNavAbout" Style="{StaticResource IconButton}" Content="&#xE897;" ToolTip="About" Click="BtnNavAbout_Click"/>
                                <Rectangle x:Name="rectAboutActive" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>

                        <!-- Bottom: Settings -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <Grid Width="48" Height="48">
                                <Button x:Name="btnNavSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="BtnNavSettings_Click"/>
                                <Rectangle x:Name="rectSettingsActive" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════ -->
                <!--  RIGHT: Main Panel                            -->
                <!-- ══════════════════════════════════════════════ -->
                <Border Grid.Column="1" Background="{StaticResource BgMain}"
                        CornerRadius="0,10,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>   <!-- title bar -->
                            <RowDefinition Height="*"/>    <!-- content -->
                        </Grid.RowDefinitions>

                        <!-- Title Bar -->
                        <Border Grid.Row="0" Background="{StaticResource BgSidebar}"
                                CornerRadius="0,10,0,0"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid>
                                <TextBlock Text="Sonar Auto Switch"
                                           Foreground="{StaticResource TxtSecond}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <!-- Window controls -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Style="{StaticResource TitleBarButton}"
                                            Content="&#xE921;"
                                            ToolTip="Minimize"
                                            Click="MinimizeButton_Click"/>
                                    <Button Style="{StaticResource TitleBarButton}"
                                            Content="&#xE923;"
                                            ToolTip="Maximize"
                                            Click="MaximizeButton_Click"/>
                                    <Button Style="{StaticResource CloseButton}"
                                            Content="&#xE8BB;"
                                            ToolTip="Close"
                                            Click="CloseButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Page: Profiles (Home) ── -->
                        <Grid x:Name="pageProfiles" Grid.Row="1" Margin="24,20,24,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- page header -->
                                <RowDefinition Height="Auto"/>  <!-- default config -->
                                <RowDefinition Height="Auto"/>  <!-- per app label -->
                                <RowDefinition Height="*"/>     <!-- app list + detail -->
                                <RowDefinition Height="Auto"/>  <!-- status bar -->
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock x:Name="lblPageHeader"
                                           Text="Auto Switch Profiles"
                                           FontFamily="Segoe UI" FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TxtPrimary}"/>
                                <!-- Connection LED top-right -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="ledStatus" Width="7" Height="7"
                                             Fill="{StaticResource Red}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtConnectionStatus"
                                               Text="Connecting..."
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource TxtSecond}"/>
                                    <Button Style="{StaticResource FlatButton}"
                                            Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                            FontSize="12" Padding="6,2"
                                            Margin="8,0,0,0" ToolTip="Refresh connection"
                                            Click="BtnRefresh_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Default Config Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="lblDefaultConfig"
                                           Text="Default config:"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TxtPrimary}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ComboBox Grid.Column="1" x:Name="cbDefaultPreset"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectionChanged="CbDefaultPreset_SelectionChanged"/>
                            </Grid>

                            <!-- Per App Label -->
                            <TextBlock Grid.Row="2" x:Name="lblPerApp"
                                       Text="Per app config:"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TxtPrimary}"
                                       Margin="0,0,0,10"/>

                            <!-- App List + Detail Panel -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Rules List -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource BgCard}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="16,4,16,4"
                                        Margin="0,0,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="spRules" Margin="0"/>
                                    </ScrollViewer>
                                </Border>


                            </Grid>

                            <!-- Status / Action Bar -->
                            <Border Grid.Row="4" Margin="0,10,0,0"
                                    Background="{StaticResource BgCard}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Active EQ info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse x:Name="ledActive" Width="6" Height="6"
                                                 Fill="{StaticResource TxtSecond}"
                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtActivePreset"
                                                   FontFamily="Segoe UI" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   VerticalAlignment="Center"
                                                   Text="Bağlanıyor..."/>
                                    </StackPanel>
                                    <!-- Scan button -->
                                    <Button Grid.Column="1"
                                            x:Name="btnScan"
                                            Style="{StaticResource FlatButton}"
                                            Padding="10,5"
                                            Foreground="{StaticResource TxtSecond}"
                                            FontSize="11"
                                            Click="BtnScan_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblScanBtn" Text="Yüklü Oyunları Tara"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── Page: Devices ── -->
                        <Grid x:Name="pageDevices" Grid.Row="1" Margin="24,20,24,20" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Cihaz Yöneticisi" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Seçilen ses aygıtları, SteelSeries Sonar tarafından tekrar aktif edilmesini önlemek amacıyla arka planda otomatik olarak devredışı tutulur." FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Playback Devices -->
                                <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="HOPARLÖRLER (PLAYBACK)" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TxtSecond}" Margin="4,0,0,10"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="spPlaybackDevices"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Recording Devices -->
                                <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="MİKROFONLAR (RECORDING)" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TxtSecond}" Margin="4,0,0,10"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="spRecordingDevices"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Save Devices Button -->
                            <Border Grid.Row="3" Margin="0,16,0,0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="20,14">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TxtSecond}" Text="Ayarları kaydedip hemen uygulamak için aşağıdaki butona basın."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtSaveDevicesStatus" Text="Kaydedildi ✔" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#4EC97E" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Button x:Name="btnSaveDevices" Style="{StaticResource AccentButton}" Padding="22,9" Click="BtnSaveDevices_Click">
                                            <TextBlock Text="Kaydet ve Uygula" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── Page: Settings ── -->
                        <Grid x:Name="pageSettings" Grid.Row="1" Margin="24,20,24,20" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="lblSettingsHeader"
                                       Text="Settings"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TxtPrimary}"
                                       Margin="0,0,0,20"/>

                            <StackPanel Grid.Row="1">

                                <!-- General settings card -->
                                <Border Background="{StaticResource BgCard}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="GENEL" FontFamily="Segoe UI"
                                                   x:Name="lblGeneralSection"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   Margin="0,0,0,14"/>

                                        <!-- Start with Windows -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="lblStartWithWin"
                                                           Text="Windows ile Başlat"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock x:Name="lblStartWithWinDesc"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           Text="Bilgisayar açılınca tray'de sessizce çalışır"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="chkStartup"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Margin="16,0,0,0"
                                                      Checked="Setting_Changed"
                                                      Unchecked="Setting_Changed"/>
                                        </Grid>

                                        <Border Background="{StaticResource Border}" Height="1" Margin="0,0,0,14"/>

                                        <!-- Language -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="lblLanguage"
                                                           Text="Dil / Language"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           Text="Arayüz dili"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="cbLanguage"
                                                      SelectionChanged="CbLanguage_SelectionChanged">
                                                <ComboBoxItem Content="Türkçe" Tag="TR"/>
                                                <ComboBoxItem Content="English" Tag="EN"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Background="{StaticResource Border}" Height="1" Margin="0,0,0,14"/>

                                        <!-- Scan interval -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="lblScanInterval"
                                                           Text="Tarama sıklığı (ms)"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock x:Name="lblScanIntervalDesc"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           Text="Aktif pencere ne sıklıkla kontrol edilsin"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" x:Name="txtInterval" Text="1000"
                                                     VerticalContentAlignment="Center" 
                                                     LostFocus="TxtInterval_LostFocus" />
                                        </Grid>

                                        <Border Background="{StaticResource Border}" Height="1" Margin="0,0,0,14"/>

                                        <!-- Clear Scanned Games -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="lblClearScannedGames"
                                                           Text="Taranmış Oyunları Temizle"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock x:Name="lblClearScannedGamesDesc"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           Text="Arka planda keşfedilen tüm exe isimlerini sıfırlar"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource DangerButton}"
                                                    Padding="16,8" VerticalAlignment="Center"
                                                    Click="BtnClearGames_Click">
                                                <TextBlock x:Name="lblBtnClear" Text="Sıfırla" FontFamily="Segoe UI" FontSize="12"/>
                                            </Button>
                                        </Grid>

                                        <Border Background="{StaticResource Border}" Height="1" Margin="0,14,0,14"/>

                                        <!-- Add Manual Game -->
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="lblManualAdd"
                                                           Text="Manuel Oyun Ekle"
                                                           FontFamily="Segoe UI" FontSize="13"
                                                           Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock x:Name="lblManualAddDesc"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           Text="Eğer taramada bulunamadıysa EXE dosyasını seçin"
                                                           Margin="0,3,0,8"/>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="lblManualExe" Text="EXE Adı" FontSize="11" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,2"/>
                                                    <Grid Grid.Row="1" Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" x:Name="txtManualExe" Text="" IsReadOnly="True" />
                                                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="..." Margin="6,0,0,0" Padding="12,0" Click="BtnBrowseExe_Click" ToolTip="EXE Dosyası Seç"/>
                                                    </Grid>
                                                    
                                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblManualName" Text="Görünür Ad (İsteğe bağlı)" FontSize="11" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtManualName" Text="" />
                                                    
                                                    <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource AccentButton}"
                                                            Padding="16,0" VerticalAlignment="Stretch"
                                                            Click="BtnAddManual_Click">
                                                        <TextBlock x:Name="lblBtnAddManual" Text="Ekle" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Save button row -->
                                <Border Margin="0,16,0,0"
                                        Background="{StaticResource BgCard}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="20,14">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI" FontSize="12"
                                                       Foreground="{StaticResource TxtSecond}"
                                                       Text="Değişiklikleri kaydetmek için aşağıdaki butona basın."/>
                                        </StackPanel>
                                        <Button x:Name="btnSave"
                                                Style="{StaticResource AccentButton}"
                                                Padding="22,9"
                                                HorizontalAlignment="Right"
                                                Click="BtnSaveSettings_Click">
                                            <TextBlock x:Name="lblSaveBtn" Text="Kaydet"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── Page: About ── -->
                        <Grid x:Name="pageAbout" Grid.Row="1" Margin="24,20,24,20"
                              Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Sonar Auto Switch"
                                           FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="v2.1"
                                           FontFamily="Segoe UI" FontSize="14"
                                           Foreground="{StaticResource Accent}" Margin="0,0,0,20"/>

                                <Border Background="{StaticResource BgCard}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock FontFamily="Segoe UI" FontSize="12"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   TextWrapping="Wrap"
                                                   Text="Automatically switches SteelSeries Sonar EQ profiles based on which game is currently running."/>
                                        <Separator Background="{StaticResource Border}"/>
                                        <TextBlock FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   Text="• Requires SteelSeries GG to be running&#x0a;• Uses local Sonar API for low-latency profile switching&#x0a;• Game EQ stays active even when alt-tabbing"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource FlatButton}"
                                        Content="Hide to Tray"
                                        Padding="14,7" Margin="0,20,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnHide_Click"/>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
